# Use "mock" to run the project without spending money or calling an external API.
PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_COST_PER_MILLION=
OPENAI_OUTPUT_COST_PER_MILLION=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_INPUT_COST_PER_MILLION=
ANTHROPIC_OUTPUT_COST_PER_MILLION=
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
DATABASE_URL=sqlite+aiosqlite:///./inferenceiq.db
AUTO_CREATE_SCHEMA=true
INFERENCEIQ_LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=inferenceiq
LANGGRAPH_CHECKPOINT_URL=./inferenceiq-checkpoints.sqlite
LANGGRAPH_STRICT_MSGPACK=true
INFERENCEIQ_AUTH_REQUIRED=false
INFERENCEIQ_ADMIN_TOKEN=dev-admin-key
INFERENCEIQ_AUDIT_SIGNING_KEY=dev-audit-signing-key
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=30
HEALTH_EWMA_ALPHA=0.2
DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
